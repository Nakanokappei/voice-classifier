# Azure OpenAI credentials (required)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Deployment names — one per pipeline stage (required)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_NAMER_DEPLOYMENT=
AZURE_OPENAI_ADVISOR_DEPLOYMENT=

# Optional overrides
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_REQUEST_TIMEOUT=60
# Override the namer model family when the deployment name does not hint at it
# (one of: gpt-5, o1, o3, o4). Affects max_completion_tokens / temperature handling.
# AZURE_OPENAI_NAMER_MODEL_FAMILY=
